# ──────────────────────────────────────────────────────────────────
# WorldMap AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://worldmap:worldmap@localhost:5432/worldmap
POSTGRES_USER=worldmap
POSTGRES_PASSWORD=worldmap
POSTGRES_DB=worldmap
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (optional — only needed for caching / rate limiting) ────
# REDIS_URL=redis://localhost:6379/0

# ── AI Provider (optional — core map works without this) ──────────
# AI_PROVIDER=openai          # openai | anthropic | none
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=gpt-4o             # model to use with the provider

# ── Data ──────────────────────────────────────────────────────────
# Directory where downloaded datasets are stored (created automatically)
DATA_DIRECTORY=./datasets

# Natural Earth dataset version to download
NATURAL_EARTH_VERSION=5.1.2

# ── API ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# MapTiler API key (optional — for raster basemap tiles)
# Without this key, only vector features are shown (no basemap tiles)
# NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
